# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/hospitaid?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="générer-avec: openssl rand -base64 32"

# Paiement (mode sandbox tant qu'aucun prestataire réel n'est confirmé)
PAYMENT_PROVIDER_MODE="TEST"
# PAYMENT_PROVIDER_API_KEY=   # à renseigner une fois le prestataire choisi (jamais commité)

# Environnement
NODE_ENV="development"
